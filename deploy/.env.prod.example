# MediZen Clinic CMS — PRODUCTION environment.
# Copy to `.env.prod` and fill real values.  NEVER commit `.env.prod`.
#   cp .env.prod.example .env.prod && nano .env.prod

# ── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── Database (Postgres service) ──────────────────────────────────────────────
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# Must match POSTGRES_* above (host = the compose service name `postgres`).
DATABASE_URL=postgresql+asyncpg://cms:CHANGE_ME_strong_db_password@postgres:5432/cms

# ── Redis / cache + Arq queue ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: ≥32 chars, random. App refuses to start in prod with a placeholder.
#   generate:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# The web app is served same-origin (nginx proxies /api), so CORS is usually not
# needed. Set your public origin(s) if the API is called cross-origin.
CORS_ORIGINS=["https://clinic.example.com"]

# ── KMS / envelope encryption (PII at rest) ─────────────────────────────────
# PRODUCTION MUST use Vault. "local-dev" is NOT safe for real PII.
KMS_PROVIDER=vault
VAULT_ADDR=https://vault.internal:8200
VAULT_TRANSIT_KEY_NAME=clinic-cms-master
# Auth: either a token, or AppRole (role_id + secret_id).
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Fallback ONLY if you accept the risk (NOT recommended for real PII):
#   KMS_PROVIDER=local-dev
#   LOCAL_DEV_MASTER_KEY=<32-byte base64 key, keep stable & secret>

# ── Superadmin (seeded once on first boot, idempotent) ───────────────────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME_strong_superadmin_password

# ── Email (optional; default just logs to console) ──────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@clinic.example.com
EMAIL_FROM_NAME=MediZen
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# ── Alerting (optional) ──────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=

# ── Deploy-time knobs (read by docker-compose.prod.yml / deploy.sh) ──────────
API_WORKERS=4
# Published ports on the host:
WEB_PORT=80
API_PORT=8000
# Source repos + branch pulled by deploy.sh (override if forked / private mirror):
BE_REPO=git@github.com:chien0661/medizen-clinic-be.git
FE_REPO=git@github.com:chien0661/medizen-clinic-web.git
DEPLOY_BRANCH=main
